/* subpackages/tarot/pages/spread-select/index.wxss */
.section-header {
  margin-top: 24rpx;
  margin-bottom: 36rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
}

.page-subtitle {
  font-size: 22rpx;
  color: #8E889B;
  margin-top: 8rpx;
}

.spread-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.spread-card {
  padding: 32rpx;
  box-sizing: border-box;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.spread-name-zh {
  font-size: 32rpx;
  font-weight: bold;
  color: #FAF5FF;
}

.spread-slots-count {
  font-size: 20rpx;
  color: #D4AF37;
  border: 1rpx solid rgba(212, 175, 55, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.spread-name-en {
  font-size: 20rpx;
  color: #8E889B;
  margin-bottom: 16rpx;
  display: block;
}

.spread-desc {
  font-size: 24rpx;
  color: #C3BED0;
  line-height: 1.5;
}
