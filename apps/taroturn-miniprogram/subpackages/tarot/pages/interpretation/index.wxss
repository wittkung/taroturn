/* subpackages/tarot/pages/interpretation/index.wxss */
.report-header {
  margin-top: 24rpx;
  margin-bottom: 36rpx;
  text-align: center;
}

.report-title {
  font-size: 36rpx;
  font-weight: bold;
}

.report-subtitle {
  font-size: 22rpx;
  color: #8E889B;
  margin-top: 8rpx;
}

.report-content {
  width: 100%;
  padding: 36rpx;
  box-sizing: border-box;
  margin-bottom: 48rpx;
}

.energy-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.energy-label {
  color: #8E889B;
}

.energy-val {
  font-weight: bold;
}

.divider {
  height: 1rpx;
  background: rgba(212, 175, 55, 0.2);
  margin: 24rpx 0;
}

.oracle-text {
  font-size: 26rpx;
  color: #FAF5FF;
  line-height: 1.6;
}

.actions-area {
  width: 100%;
}

.export-btn {
  background: linear-gradient(135deg, #D4AF37 0%, #AA820A 100%);
  color: #0E081A;
  font-weight: bold;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  padding: 20rpx 0;
  width: 100%;
}
