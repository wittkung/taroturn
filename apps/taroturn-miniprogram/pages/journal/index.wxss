/* pages/journal/index.wxss */
.journal-header {
  margin-top: 40rpx;
  margin-bottom: 48rpx;
  text-align: center;
}

.journal-title {
  font-size: 40rpx;
  font-weight: bold;
}

.journal-subtitle {
  font-size: 22rpx;
  color: #8E889B;
  margin-top: 8rpx;
}

.empty-state {
  width: 100%;
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #FAF5FF;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #8E889B;
  line-height: 1.5;
}
