/* components/tarot-card/index.wxss */
.tarot-card-scene {
  width: 180rpx;
  height: 300rpx;
  perspective: 1000px;
  margin: 16rpx;
}

.tarot-card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.tarot-card-inner.flipped {
  transform: rotateY(180deg);
}

.tarot-card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 16rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.4);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.tarot-card-back {
  background: radial-gradient(circle at 50% 50%, #201335 0%, #0E081A 100%);
  transform: rotateY(0deg);
}

.back-pattern {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sacred-geometry-star {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #D4AF37;
  transform: rotate(45deg);
  margin-bottom: 16rpx;
}

.back-text {
  font-size: 18rpx;
  color: #D4AF37;
  letter-spacing: 4rpx;
}

.tarot-card-front {
  background: #18102A;
  transform: rotateY(180deg);
}

.front-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card-name-zh {
  font-size: 24rpx;
  font-weight: bold;
  color: #FAF5FF;
  margin-bottom: 4rpx;
}

.card-name-en {
  font-size: 16rpx;
  color: #8E889B;
  margin-bottom: 12rpx;
}

.card-element-tag {
  font-size: 16rpx;
  color: #2E8B57;
  margin-bottom: 8rpx;
}

.card-orientation-tag {
  font-size: 18rpx;
  font-weight: bold;
}

.card-orientation-tag.upright {
  color: #D4AF37;
}

.card-orientation-tag.reversed {
  color: #C0392B;
}
