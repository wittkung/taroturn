{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpreadDAGSchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_en",
    "name_zh",
    "description",
    "category",
    "slots",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "name_zh": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Daily",
        "Decision",
        "Relationship",
        "Comprehensive",
        "Custom"
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "title_en",
          "title_zh",
          "meaning_prompt",
          "x",
          "y",
          "rotation_deg",
          "z_index",
          "constraint"
        ],
        "properties": {
          "slot_id": {
            "type": "integer",
            "minimum": 0
          },
          "title_en": {
            "type": "string"
          },
          "title_zh": {
            "type": "string"
          },
          "meaning_prompt": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "rotation_deg": {
            "type": "number"
          },
          "z_index": {
            "type": "integer"
          },
          "constraint": {
            "type": "string",
            "enum": [
              "Any",
              "MajorOnly",
              "MinorOnly",
              "WandsOnly",
              "CupsOnly",
              "SwordsOnly",
              "PentaclesOnly",
              "CourtOnly",
              "PipOnly"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_slot_id",
          "target_slot_id",
          "relation",
          "weight"
        ],
        "properties": {
          "source_slot_id": {
            "type": "integer",
            "minimum": 0
          },
          "target_slot_id": {
            "type": "integer",
            "minimum": 0
          },
          "relation": {
            "type": "string",
            "enum": [
              "Crosses",
              "FlowsTo",
              "Supports",
              "Illuminates",
              "Opposes",
              "Synthesizes",
              "Reflects"
            ]
          },
          "weight": {
            "type": "number"
          }
        }
      }
    }
  }
}
