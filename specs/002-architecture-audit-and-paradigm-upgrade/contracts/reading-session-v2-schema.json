{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReadingSessionV2Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "created_at",
    "spread_id",
    "rng_seed",
    "reversal_probability",
    "placed_cards",
    "dignity_summary"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "created_at": {
      "type": "integer"
    },
    "spread_id": {
      "type": "string"
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "rng_seed": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reversal_probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "placed_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "drawn_card"
        ],
        "properties": {
          "slot_id": {
            "type": "integer"
          },
          "drawn_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "card_id",
              "orientation",
              "draw_sequence"
            ],
            "properties": {
              "card_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 77
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "Upright",
                  "Reversed"
                ]
              },
              "draw_sequence": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "dignity_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fire_ratio",
        "water_ratio",
        "air_ratio",
        "earth_ratio",
        "major_ratio",
        "reversed_ratio",
        "dominant_element",
        "pairwise_dignities",
        "overall_harmony_score",
        "balance_description_zh"
      ],
      "properties": {
        "fire_ratio": {
          "type": "number"
        },
        "water_ratio": {
          "type": "number"
        },
        "air_ratio": {
          "type": "number"
        },
        "earth_ratio": {
          "type": "number"
        },
        "major_ratio": {
          "type": "number"
        },
        "reversed_ratio": {
          "type": "number"
        },
        "dominant_element": {
          "type": "string"
        },
        "shadow_card_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pairwise_dignities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_slot_id",
              "target_slot_id",
              "source_card_id",
              "target_card_id",
              "relation",
              "source_element",
              "target_element",
              "affinity",
              "dignity_status",
              "tension_score",
              "dynamic_summary_zh"
            ],
            "properties": {
              "source_slot_id": {
                "type": "integer"
              },
              "target_slot_id": {
                "type": "integer"
              },
              "source_card_id": {
                "type": "integer"
              },
              "target_card_id": {
                "type": "integer"
              },
              "relation": {
                "type": "string"
              },
              "source_element": {
                "type": "string"
              },
              "target_element": {
                "type": "string"
              },
              "affinity": {
                "type": "string"
              },
              "dignity_status": {
                "type": "string"
              },
              "tension_score": {
                "type": "number"
              },
              "dynamic_summary_zh": {
                "type": "string"
              }
            }
          }
        },
        "overall_harmony_score": {
          "type": "number"
        },
        "balance_description_zh": {
          "type": "string"
        }
      }
    },
    "user_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_interpretation": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
