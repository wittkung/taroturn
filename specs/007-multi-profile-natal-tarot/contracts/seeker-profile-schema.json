{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeekerProfileContract",
  "description": "Schema contract for individual seeker profile in the multi-profile natal tarot registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "nickname",
    "title",
    "birthdate",
    "lifePathNumber",
    "soulCardId",
    "personalityCardId",
    "dominantZodiac",
    "dominantElement",
    "personalMotto"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the seeker profile"
    },
    "name": {
      "type": "string",
      "description": "Custom name or label of the person (e.g. 'Myself', 'Partner', 'Alex')"
    },
    "nickname": {
      "type": "string",
      "description": "Display nickname"
    },
    "title": {
      "type": "string",
      "description": "Spiritual or archetypal title"
    },
    "birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Birthdate in YYYY-MM-DD format"
    },
    "lifePathNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33,
      "description": "Calculated numerology life path number"
    },
    "soulCardId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 21,
      "description": "Calculated major arcana soul card ID"
    },
    "personalityCardId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 21,
      "description": "Calculated major arcana personality card ID"
    },
    "dominantZodiac": {
      "type": "string",
      "description": "Zodiac sign derived from birthdate"
    },
    "dominantElement": {
      "type": "string",
      "enum": ["Fire", "Water", "Air", "Earth"],
      "description": "Dominant astrological element"
    },
    "personalMotto": {
      "type": "string",
      "description": "Archetypal motto for the seeker"
    },
    "createdAt": {
      "type": "string",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "description": "ISO 8601 last update timestamp"
    }
  }
}
