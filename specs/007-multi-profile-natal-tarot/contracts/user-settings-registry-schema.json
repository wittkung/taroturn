{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserSettingsRegistryContract",
  "description": "Schema contract for top-level user settings including multi-profile registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "profile",
    "profiles",
    "activeProfileId"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "description": "Active profile mirror for backward compatibility",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "title": { "type": "string" },
        "birthdate": { "type": "string" },
        "lifePathNumber": { "type": "integer" },
        "soulCardId": { "type": "integer" },
        "personalityCardId": { "type": "integer" },
        "dominantZodiac": { "type": "string" },
        "dominantElement": { "type": "string" },
        "personalMotto": { "type": "string" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "description": "Registry of all saved seeker profiles",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "nickname": { "type": "string" },
          "title": { "type": "string" },
          "birthdate": { "type": "string" },
          "lifePathNumber": { "type": "integer" },
          "soulCardId": { "type": "integer" },
          "personalityCardId": { "type": "integer" },
          "dominantZodiac": { "type": "string" },
          "dominantElement": { "type": "string" },
          "personalMotto": { "type": "string" }
        }
      }
    },
    "activeProfileId": {
      "type": "string",
      "description": "ID of the currently active seeker profile"
    }
  }
}
