{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppleSwiftDataSyncContract",
  "description": "Schema for SwiftData encrypted CloudKit synchronization record payloads",
  "type": "object",
  "required": ["recordId", "entityType", "updatedAt", "payload"],
  "properties": {
    "recordId": {
      "type": "string",
      "format": "uuid"
    },
    "entityType": {
      "type": "string",
      "enum": ["ReadingRecord", "JournalEntryRecord", "OtpDeckRecord"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["rngSeedHex", "spreadId"],
      "properties": {
        "rngSeedHex": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "spreadId": {
          "type": "string"
        },
        "question": {
          "type": ["string", "null"]
        },
        "dominantElement": {
          "type": ["string", "null"]
        },
        "harmonyScore": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
