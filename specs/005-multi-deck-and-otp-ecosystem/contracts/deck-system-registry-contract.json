{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeckSystemRegistryContract",
  "description": "Schema for registered deck systems metadata",
  "type": "object",
  "required": ["deckId", "family", "displayName", "version", "author", "supportsPhysicalReversals"],
  "properties": {
    "deckId": { "type": "string" },
    "family": {
      "type": "string",
      "enum": ["rider_waite_smith", "crowley_thoth", "tarot_de_marseille", "custom"]
    },
    "displayName": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "supportsPhysicalReversals": { "type": "boolean" },
    "isBuiltIn": { "type": "boolean" }
  },
  "additionalProperties": false
}
